; SPDX-License-Identifier: MS-PL
; Source-only INF scaffold. The referenced SYS/CAT are produced and signed by
; the private WDK release pipeline; neither is stored in this repository.

[Version]
Signature="$WINDOWS NT$"
Class=MEDIA
ClassGuid={4D36E96C-E325-11CE-BFC1-08002BE10318}
Provider=%HibikiProvider%
CatalogFile=HibikiVirtualAudio.cat
DriverVer=08/21/2026,0.1.0.0
PnpLockdown=1

[Manufacturer]
%HibikiProvider%=Hibiki,NTamd64

[Hibiki.NTamd64]
%HibikiMain.DeviceDesc%=HibikiMain_Install,Root\HibikiDSP

[HibikiMain_Install]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=HibikiDriver.CopyFiles
AddReg=HibikiMain.AddReg

[HibikiMain_Install.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_TopologyMain%,Hibiki.I.TopologyMain,
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_TopologyMain%,Hibiki.I.TopologyMain,
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_WaveMain%,Hibiki.I.WaveMain,
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_WaveMain%,Hibiki.I.WaveMainRender,
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_WaveMain%,Hibiki.I.WaveMain,
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_TopologyLowLatency%,Hibiki.I.TopologyLowLatency,
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_TopologyLowLatency%,Hibiki.I.TopologyLowLatency,
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_WaveLowLatency%,Hibiki.I.WaveLowLatency,
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_WaveLowLatency%,Hibiki.I.WaveLowLatencyRender,
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_WaveLowLatency%,Hibiki.I.WaveLowLatency,
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_TopologySurround%,Hibiki.I.TopologySurround,
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_TopologySurround%,Hibiki.I.TopologySurround,
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_WaveSurround%,Hibiki.I.WaveSurround,
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_WaveSurround%,Hibiki.I.WaveSurroundRender,
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_WaveSurround%,Hibiki.I.WaveSurround,
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_TopologyVirtualMic%,Hibiki.I.TopologyVirtualMic,
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_TopologyVirtualMic%,Hibiki.I.TopologyVirtualMic,
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_WaveVirtualMic%,Hibiki.I.WaveVirtualMic,
AddInterface=%KSCATEGORY_CAPTURE%,%KSNAME_WaveVirtualMic%,Hibiki.I.WaveVirtualMicCapture,
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_WaveVirtualMic%,Hibiki.I.WaveVirtualMic,

[HibikiMain_Install.Services]
AddService=HibikiVirtualAudio,0x00000002,HibikiVirtualAudio.Service

[HibikiDriver.CopyFiles]
HibikiVirtualAudio.sys

[HibikiMain.AddReg]
; Stable endpoint identities are consumed by the eventual SYSVAD-derived
; topology. The values are documented in distribution-profile.yml.
HKR,,EndpointMainGuid,0x00000000,"8b9b2a8f-09a4-4e57-9f24-5d7cbd50ce10"
HKR,,EndpointLowLatencyGuid,0x00000000,"6d5706a4-b661-4bf6-9c2d-9c31b8f7df21"
HKR,,EndpointSurroundGuid,0x00000000,"d4a21e0f-83e5-4a6e-92dc-44d13f9e6c93"
HKR,,EndpointVirtualMicGuid,0x00000000,"5e90de25-0e88-4892-8b0e-a1d521cb3f40"

[HibikiVirtualAudio.Service]
DisplayName=%HibikiServiceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\HibikiVirtualAudio.sys

[SourceDisksFiles]
HibikiVirtualAudio.sys=1

[SourceDisksNames]
1=%DiskName%,,

[DestinationDirs]
HibikiDriver.CopyFiles=12

; Per-subdevice interface registrations (proxy CLSID for PortCls KS filters)
[Hibiki.I.TopologyMain]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%TopologyMain.DeviceDesc%

[Hibiki.I.WaveMain]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%WaveMain.DeviceDesc%

[Hibiki.I.TopologyLowLatency]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%TopologyLowLatency.DeviceDesc%

[Hibiki.I.WaveLowLatency]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%WaveLowLatency.DeviceDesc%

[Hibiki.I.TopologySurround]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%TopologySurround.DeviceDesc%

[Hibiki.I.WaveSurround]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%WaveSurround.DeviceDesc%

[Hibiki.I.TopologyVirtualMic]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%TopologyVirtualMic.DeviceDesc%

[Hibiki.I.WaveVirtualMic]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%WaveVirtualMic.DeviceDesc%

[Strings]
HibikiProvider="Hibiki DSP"
HibikiMain.DeviceDesc="Hibiki Virtual Audio (source-only package)"
HibikiServiceDesc="Hibiki Virtual Audio"
DiskName="Hibiki Virtual Audio Driver"

; KS proxy CLSID and categories
Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_CAPTURE="{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY="{DDA54A40-1E4C-11D1-A050-405705C10000}"

; Subdevice names must exactly match PcRegisterSubdevice calls.
KSNAME_TopologyMain="TopologyMain"
KSNAME_WaveMain="WaveMain"
KSNAME_TopologyLowLatency="TopologyLowLatency"
KSNAME_WaveLowLatency="WaveLowLatency"
KSNAME_TopologySurround="TopologySurround"
KSNAME_WaveSurround="WaveSurround"
KSNAME_TopologyVirtualMic="TopologyVirtualMic"
KSNAME_WaveVirtualMic="WaveVirtualMic"

TopologyMain.DeviceDesc="Hibiki Main Topology"
WaveMain.DeviceDesc="Hibiki Main Wave"
TopologyLowLatency.DeviceDesc="Hibiki Low Latency Topology"
WaveLowLatency.DeviceDesc="Hibiki Low Latency Wave"
TopologySurround.DeviceDesc="Hibiki Surround 7.1 Topology"
WaveSurround.DeviceDesc="Hibiki Surround 7.1 Wave"
TopologyVirtualMic.DeviceDesc="Hibiki Virtual Mic Topology"
WaveVirtualMic.DeviceDesc="Hibiki Virtual Mic Wave"
