{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hibiki.example/schemas/graph-config-v1.schema.json",
  "title": "Hibiki GraphConfig v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lanes", "output_channels", "strict_direct", "sample_format"],
  "properties": {
    "schema_version": {"const": 1},
    "output_channels": {"enum": [2, 6, 8]},
    "strict_direct": {"type": "boolean"},
    "sample_format": {"enum": [0, 1]},
    "lanes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "output_group", "channel_count", "makeup_gain_db", "enabled", "channel_map"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 64, "$ref": "printable-string-v1.schema.json#/$defs/printableString"},
          "output_group": {"type": "string", "minLength": 1, "maxLength": 64, "$ref": "printable-string-v1.schema.json#/$defs/printableString"},
          "channel_count": {"enum": [2, 6, 8]},
          "makeup_gain_db": {"type": "number", "minimum": -144, "maximum": 12},
          "enabled": {"type": "boolean"},
          "reported_latency_samples": {"type": "integer", "minimum": 0, "maximum": 16384},
          "channel_map": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "integer", "minimum": -1, "maximum": 7}},
          "matrix_enabled": {"type": "boolean"},
          "channel_matrix": {
            "type": "array", "minItems": 8, "maxItems": 8,
            "items": {"type": "array", "minItems": 8, "maxItems": 8,
              "items": {"type": "number", "minimum": -8, "maximum": 8}}
          }
        }
      }
    }
  }
}
