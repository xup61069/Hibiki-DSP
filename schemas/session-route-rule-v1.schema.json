{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hibiki.example/schemas/session-route-rule-v1.schema.json",
  "title": "Hibiki per-application session route rule v1",
  "description": "Control-plane metadata for deterministic app routing; process IDs are never persisted as profile identity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rule_id", "priority", "enabled", "match", "lane_id", "output_group", "gain_owner", "makeup_gain_db"],
  "properties": {
    "schema_version": {"const": 1},
    "rule_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "priority": {"type": "integer", "minimum": -1000000, "maximum": 1000000},
    "enabled": {"type": "boolean"},
    "match": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "app_id": {"type": "string", "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$"},
        "display_name_contains": {"type": "string", "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$"}
      }
    },
    "lane_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$"},
    "output_group": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$"},
    "gain_owner": {"enum": ["windows-session", "hibiki-internal"]},
    "makeup_gain_db": {"type": "number", "minimum": -144, "maximum": 12}
  }
}
