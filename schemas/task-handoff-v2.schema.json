{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hibiki.example/schemas/task-handoff-v2.schema.json",
  "title": "Hibiki TaskHandoff v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue",
    "branch",
    "target_branch",
    "base_commit",
    "status",
    "role",
    "owner",
    "updated_at",
    "scope_globs",
    "shared_paths",
    "depends_on",
    "next_safe_action",
    "resume_commands"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "issue": {"type": "integer", "minimum": 0},
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "target_branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "base_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{7,40}$"},
    "status": {"enum": ["planned", "in_progress", "blocked", "ready_for_review", "completed"]},
    "role": {"enum": ["worker", "integrator"]},
    "owner": {"type": "string", "minLength": 1, "maxLength": 80},
    "updated_at": {"type": "string", "format": "date-time"},
    "merge_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{7,40}$"},
    "environment_fingerprint": {"type": "string"},
    "scope_globs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 200}
    },
    "shared_paths": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 200}
    },
    "depends_on": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "specs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "adrs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "next_safe_action": {"type": "string", "minLength": 1, "maxLength": 500},
    "resume_commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {"type": "string", "minLength": 1, "maxLength": 300}
    }
  }
}
