{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hibiki.example/schemas/task-handoff-v1.schema.json",
  "title": "Hibiki TaskHandoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue", "branch", "base_commit", "status", "updated_at", "next_safe_action"],
  "properties": {
    "schema_version": {"const": 1},
    "issue": {"type": "integer", "minimum": 0},
    "branch": {"type": "string"},
    "base_commit": {"type": "string"},
    "status": {"enum": ["planned", "in_progress", "blocked", "ready_for_review"]},
    "updated_at": {"type": "string", "format": "date-time"},
    "environment_fingerprint": {"type": "string"},
    "specs": {"type": "array", "items": {"type": "string"}},
    "adrs": {"type": "array", "items": {"type": "string"}},
    "next_safe_action": {"type": "string", "minLength": 1}
  }
}
