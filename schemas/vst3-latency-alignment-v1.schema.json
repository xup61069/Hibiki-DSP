{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hibiki.example/schemas/vst3-latency-alignment-v1.schema.json",
  "title": "Hibiki VST3 latency alignment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lane_count", "maximum_latency_samples", "delay_samples"],
  "properties": {
    "schema_version": {"const": 1},
    "lane_count": {"type": "integer", "minimum": 0, "maximum": 32},
    "maximum_latency_samples": {"type": "integer", "minimum": 0, "maximum": 16384},
    "delay_samples": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {"type": "integer", "minimum": 0, "maximum": 16384}
    }
  }
}
