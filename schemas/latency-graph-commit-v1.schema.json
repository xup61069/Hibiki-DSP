{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hibiki.example/schemas/latency-graph-commit-v1.schema.json",
  "title": "Hibiki latency graph commit v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "base_graph_revision", "target_graph_revision", "lane_count", "maximum_latency_samples", "lanes"],
  "properties": {
    "schema_version": {"const": 1},
    "base_graph_revision": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "target_graph_revision": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "lane_count": {"type": "integer", "minimum": 0, "maximum": 32},
    "maximum_latency_samples": {"type": "integer", "minimum": 0, "maximum": 16384},
    "lanes": {
      "type": "array", "minItems": 32, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["lane_token", "active", "channel_count", "reported_latency_samples", "compensation_delay_samples"],
        "properties": {
          "lane_token": {"type": "integer", "minimum": 1},
          "active": {"type": "boolean"},
          "channel_count": {"enum": [2, 6, 8]},
          "reported_latency_samples": {"type": "integer", "minimum": 0, "maximum": 16384},
          "compensation_delay_samples": {"type": "integer", "minimum": 0, "maximum": 16384}
        }
      }
    }
  }
}
