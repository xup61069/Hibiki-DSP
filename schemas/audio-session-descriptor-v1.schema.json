{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hibiki.example/schemas/audio-session-descriptor-v1.schema.json",
  "title": "Hibiki AudioSessionDescriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity", "display_name", "app_id", "active", "gain_owner", "lane_id", "output_group", "makeup_gain_db"],
  "properties": {
    "schema_version": {"const": 1},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint_id", "session_instance_id", "process_id"],
      "properties": {
        "endpoint_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "session_instance_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "process_id": {"type": "integer", "minimum": 0, "maximum": 4294967295}
      }
    },
    "display_name": {"type": "string", "maxLength": 256},
    "app_id": {"type": "string", "maxLength": 256},
    "active": {"type": "boolean"},
    "gain_owner": {"enum": ["windows-session", "hibiki-internal"]},
    "lane_id": {"type": "string", "maxLength": 256},
    "output_group": {"type": "string", "maxLength": 256},
    "makeup_gain_db": {"type": "number", "minimum": -144, "maximum": 12}
  }
}
