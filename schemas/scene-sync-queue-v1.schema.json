{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hibiki.example/schemas/scene-sync-queue-v1.schema.json",
  "title": "Hibiki offline scene sync replay queue v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dropped_operations", "operations"],
  "properties": {
    "schema_version": {"const": 1},
    "dropped_operations": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "operations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["is_upsert", "scene_id", "name", "output_group"],
        "properties": {
          "is_upsert": {"type": "boolean"},
          "scene_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,30}$"},
          "name": {"type": "string"},
          "output_group": {"type": "string"},
          "ir_reference": {
            "type": "string",
            "maxLength": 64,
            "$ref": "printable-string-v1.schema.json#/$defs/printableString"
          },
          "loudness_live_update": {
            "type": "boolean"
          }
        },
        "if": {
          "properties": {"is_upsert": {"const": true}},
          "required": ["is_upsert"]
        },
        "then": {
          "properties": {
            "name": {
              "minLength": 1,
              "maxLength": 120,
              "$ref": "printable-string-v1.schema.json#/$defs/printableString"
            },
            "output_group": {
              "minLength": 1,
              "maxLength": 64,
              "$ref": "printable-string-v1.schema.json#/$defs/printableString"
            },
            "ir_reference": {
              "type": "string",
              "minLength": 8,
              "maxLength": 64,
              "$ref": "printable-string-v1.schema.json#/$defs/printableString"
            }
          }
        },
        "else": {
          "properties": {
            "name": {"maxLength": 0},
            "output_group": {"maxLength": 0},
            "ir_reference": {"maxLength": 0},
            "loudness_live_update": {"const": false}
          }
        }
      }
    }
  },
  "$comment": "The if/then/else on each operation enforces: upsert requires non-empty name (max 120), output_group (max 64), and ir_reference empty or 8..64 printable bytes; remove requires all three exactly empty. loudness_live_update is an optional upsert-only boolean (absent means false) mirrored into SceneCatalogCommandV1 byte 84. The runtime parser additionally validates complete candidates before replacing the in-memory queue."
}
