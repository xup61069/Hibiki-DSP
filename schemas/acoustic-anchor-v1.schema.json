{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hibiki.example/schemas/acoustic-anchor-v1.schema.json",
  "title": "Hibiki AcousticAnchor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "device_class", "test_signal_dbfs", "measured_1k_spl_db", "uncertainty_db"],
  "properties": {
    "schema_version": {"const": 1},
    "device_class": {"enum": ["speaker", "headphone-coupler", "headphone-estimated"]},
    "test_signal_dbfs": {"type": "number"},
    "endpoint_gain_db": {"type": "number"},
    "measured_1k_spl_db": {"type": "number"},
    "uncertainty_db": {"type": "number", "minimum": 0},
    "measured_f3_hz": {"type": "number", "exclusiveMinimum": 0},
    "microphone_calibration_id": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
