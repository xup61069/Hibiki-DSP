{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hibiki.example/schemas/printable-string-v1.schema.json",
  "title": "Hibiki printable string constraint v1",
  "type": "object",
  "$defs": {
    "printableString": {
      "pattern": "^(?![\\s\\S]*[\u0000-\u001F\u007F-\u009F])"
    }
  }
}
