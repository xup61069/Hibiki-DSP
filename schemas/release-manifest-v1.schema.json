{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hibiki.example/schemas/release-manifest-v1.schema.json",
  "title": "Hibiki ReleaseManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_version", "source_tag", "source_commit", "toolchain_digest", "dependency_lock_digest", "unsigned_files", "driver_package", "installer", "sbom_digest", "tests"],
  "properties": {
    "schema_version": {"const": 1},
    "product_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "source_tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "distribution_id": {"type": "string", "minLength": 1},
    "toolchain_digest": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "dependency_lock_digest": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "unsigned_files": {"type": "array", "maxItems": 1024, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 260}, "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}}}},
    "driver_package": {"type": "object", "additionalProperties": false, "required": ["sha256", "catalog_sha256", "microsoft_signature_thumbprint"], "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}, "catalog_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}, "microsoft_signature_thumbprint": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}}},
    "installer": {"type": "object", "additionalProperties": false, "required": ["sha256", "signer_thumbprint", "rfc3161_timestamp"], "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}, "signer_thumbprint": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}, "rfc3161_timestamp": {"type": "string", "minLength": 1, "maxLength": 128}}},
    "sbom_digest": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "tests": {"type": "array", "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
    "signed_installer_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
  }
}
