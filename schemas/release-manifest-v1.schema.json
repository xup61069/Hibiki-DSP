{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hibiki.example/schemas/release-manifest-v1.schema.json",
  "title": "Hibiki ReleaseManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_version", "source_tag", "source_commit", "toolchain_digest", "unsigned_files", "tests"],
  "properties": {
    "schema_version": {"const": 1},
    "product_version": {"type": "string"},
    "source_tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "distribution_id": {"type": "string"},
    "toolchain_digest": {"type": "string"},
    "unsigned_files": {"type": "array", "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "tests": {"type": "array", "items": {"type": "string"}},
    "signed_installer_sha256": {"type": "string"}
  }
}
