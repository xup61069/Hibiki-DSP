{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hibiki.example/schemas/program-aware-level-policy-v1.schema.json",
  "title": "Hibiki ProgramAwareLevelPolicy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "enabled", "target_dbfs", "max_boost_db", "max_cut_db", "analysis_window_ms", "max_rate_db_per_second", "silence_gate_dbfs", "meter_mode", "excluded_channel"],
  "properties": {
    "schema_version": {"const": 1},
    "enabled": {"type": "boolean"},
    "target_dbfs": {"type": "number", "minimum": -60, "maximum": 0},
    "max_boost_db": {"type": "number", "minimum": 0, "maximum": 12},
    "max_cut_db": {"type": "number", "minimum": 0, "maximum": 24},
    "analysis_window_ms": {"type": "number", "minimum": 100, "maximum": 10000},
    "max_rate_db_per_second": {"type": "number", "exclusiveMinimum": 0, "maximum": 60},
    "silence_gate_dbfs": {"type": "number", "minimum": -144, "exclusiveMaximum": 0},
    "meter_mode": {"enum": ["rms-proxy", "k-weighted-proxy"]},
    "excluded_channel": {"type": "integer", "minimum": -1, "maximum": 7}
  }
}
