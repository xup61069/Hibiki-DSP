{
  "manifest_version": 3,
  "name": "Hibiki DSP single-tab capture",
  "description": "Routes the active browser tab to a Hibiki lane after a user gesture.",
  "version": "0.1.0",
  "permissions": ["activeTab", "tabCapture", "offscreen"],
  "background": {"service_worker": "service-worker.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "Capture this tab"}
}
