<UserControl x:Class="Hibiki.WinUI.Controls.ExpertSignalChainCanvas"
             x:Name="ControlRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Microsoft.UI.Xaml.Controls"
             AutomationProperties.Name="{Binding Model.AccessibleSummary, ElementName=ControlRoot}"
             AutomationProperties.HelpText="{Binding Model.BoundaryText, ElementName=ControlRoot}"
             IsTabStop="False">
    <Grid>
        <Border Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel Spacing="12">
                <TextBlock Text="{Binding Model.Title, ElementName=ControlRoot}"
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="方向由上到下；每個節點的狀態是架構分類，不是即時引擎確認。"
                           TextWrapping="Wrap"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <controls:ItemsRepeater ItemsSource="{Binding Model.Steps, ElementName=ControlRoot}">
                    <controls:ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="6">
                                <Border Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        AutomationProperties.Name="{Binding Node.AccessibleText}"
                                        AutomationProperties.HelpText="{Binding Node.Detail}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding Node.Name}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding Node.Detail}"
                                                       TextWrapping="Wrap"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Padding="8,3"
                                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                CornerRadius="4"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Node.StateText}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding ConnectorText}"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           AutomationProperties.Name="{Binding ConnectorAccessibleText}" />
                            </StackPanel>
                        </DataTemplate>
                    </controls:ItemsRepeater.ItemTemplate>
                </controls:ItemsRepeater>
                <TextBlock Text="{Binding Model.BoundaryText, ElementName=ControlRoot}"
                           TextWrapping="Wrap"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           AutomationProperties.Name="Expert 訊號鏈邊界說明" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
