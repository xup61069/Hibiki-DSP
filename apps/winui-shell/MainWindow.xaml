<Window
    x:Class="Hibiki.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Hibiki DSP">
    <Grid x:Name="RootGrid" Padding="28" Background="#111217"
          AutomationProperties.Name="Hibiki DSP 音訊場景控制">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Hibiki DSP" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Audio Scene OS" Opacity="0.72" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding ConnectionStatusText}" VerticalAlignment="Center" />
                <Button Content="連接引擎" Click="OnConnectClick"
                        AutomationProperties.Name="連接 Hibiki 音訊引擎"
                        AutomationProperties.HelpText="連接後才能套用場景與音量控制" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,24,0,24">
            <StackPanel Spacing="18" MaxWidth="760">
                <Border Padding="20" CornerRadius="12" Background="#1D2028">
                    <StackPanel Spacing="12">
                        <TextBlock Text="先選輸出，再一鍵變好聽" FontSize="22" FontWeight="SemiBold" />
                        <ComboBox Header="輸出群組"
                                  AutomationProperties.Name="輸出群組"
                                  AutomationProperties.HelpText="選擇 Main、Low Latency 或 Surround 輸出"
                                  ItemsSource="{Binding OutputGroups}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedOutputGroup, Mode=TwoWay}" />
                        <Button Content="一鍵改善" Click="OnEnhanceClick" IsEnabled="{Binding IsConnected}"
                                AutomationProperties.Name="一鍵改善聲音"
                                AutomationProperties.HelpText="套用遊戲場景、校正與音量保護" />
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Opacity="0.82"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>

                <Border Padding="20" CornerRadius="12" Background="#1D2028">
                    <StackPanel Spacing="12">
                        <TextBlock Text="場景" FontSize="20" FontWeight="SemiBold" />
                        <controls:ItemsRepeater ItemsSource="{Binding Scenes}">
                            <controls:ItemsRepeater.Layout>
                                <controls:UniformGridLayout MaximumRowsOrColumns="2" MinItemWidth="260" MinItemHeight="84" />
                            </controls:ItemsRepeater.Layout>
                            <controls:ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding Id}" Click="OnSceneClick" HorizontalContentAlignment="Stretch"
                                            AutomationProperties.Name="{Binding Name}"
                                            AutomationProperties.HelpText="{Binding Description}">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.72" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </controls:ItemsRepeater.ItemTemplate>
                        </controls:ItemsRepeater>
                    </StackPanel>
                </Border>

                <Border Padding="20" CornerRadius="12" Background="#1D2028">
                    <StackPanel Spacing="10">
                        <TextBlock Text="自訂預設" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="建立最多 32 個自訂卡片；完整 DSP graph 由引擎端 Scene catalog 驗證。"
                                   TextWrapping="Wrap" Opacity="0.72" />
                        <TextBox Header="Scene ID（英文小寫）"
                                 Text="{Binding CustomSceneId, Mode=TwoWay}"
                                 AutomationProperties.Name="自訂場景 ID"
                                 AutomationProperties.HelpText="使用小寫英數、點、底線或連字號，最多 31 字元" />
                        <TextBox Header="名稱"
                                 Text="{Binding CustomSceneName, Mode=TwoWay}"
                                 AutomationProperties.Name="自訂場景名稱" />
                        <TextBox Header="說明"
                                 Text="{Binding CustomSceneDescription, Mode=TwoWay}"
                                 AutomationProperties.Name="自訂場景說明" />
                        <Button Content="加入自訂預設" Click="OnAddCustomSceneClick"
                                AutomationProperties.Name="加入自訂預設"
                                AutomationProperties.HelpText="加入後會保存到本機 user-space preset 檔案" />
                    </StackPanel>
                </Border>

                <Border Padding="20" CornerRadius="12" Background="#1D2028">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="音量保護" FontSize="20" FontWeight="SemiBold" />
                            <ToggleSwitch Grid.Column="1" Header="Expert" IsOn="{Binding IsExpert, Mode=TwoWay}"
                                          AutomationProperties.Name="Expert 詳細模式"
                                          AutomationProperties.HelpText="顯示 Matrix、DSP Graph、VST3 與校正狀態" />
                        </Grid>
                        <Slider Minimum="-60" Maximum="0" Value="{Binding RequestedVolumeDb, Mode=TwoWay}" ValueChanged="OnVolumeChanged"
                                AutomationProperties.Name="系統音量"
                                AutomationProperties.HelpText="以 dB 調整音量；安全限制會優先套用" />
                        <TextBlock Text="{Binding RequestedVolumeDb, StringFormat='{}{0:0.0} dB'}" />
                        <ToggleSwitch Header="靜音" IsOn="{Binding Muted, Mode=TwoWay}"
                                      AutomationProperties.Name="靜音"
                                      AutomationProperties.HelpText="淡出目前輸出並保留音量設定" />
                        <TextBlock Text="{Binding IrAddedDelayMs, StringFormat='IR 額外延遲：{0:0.0} ms'}" Opacity="0.72" />
                    </StackPanel>
                </Border>

                <controls:Expander Header="Expert 詳細控制（唯讀 contract）"
                                   AutomationProperties.Name="Expert 詳細控制"
                                   AutomationProperties.HelpText="唯讀顯示 Matrix、DSP Graph、VST3 隔離與校正狀態"
                                   IsExpanded="{Binding IsExpert, Mode=TwoWay}">
                    <StackPanel x:Name="ExpertPanel" Padding="8" Spacing="14">
                        <TextBlock Text="{Binding Expert.StatusText}" TextWrapping="Wrap" />

                        <StackPanel Spacing="6">
                            <TextBlock Text="Matrix" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Expert.MatrixSummary}" Opacity="0.72" />
                            <controls:ItemsRepeater ItemsSource="{Binding Expert.MatrixRoutes}">
                                <controls:ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="4" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Source}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Destination}" />
                                            <TextBlock Grid.Column="2" Text="{Binding GainDb, StringFormat='{}{0:0.0} dB'}" />
                                        </Grid>
                                    </DataTemplate>
                                </controls:ItemsRepeater.ItemTemplate>
                            </controls:ItemsRepeater>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="DSP Graph" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Expert.DspSummary}" Opacity="0.72" />
                            <controls:ItemsRepeater ItemsSource="{Binding Expert.DspGraph}">
                                <controls:ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="4" Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" Opacity="0.72" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </controls:ItemsRepeater.ItemTemplate>
                            </controls:ItemsRepeater>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="VST3 隔離 Lane" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Expert.Vst3Summary}" Opacity="0.72" TextWrapping="Wrap" />
                            <controls:ItemsRepeater ItemsSource="{Binding Expert.Vst3Lanes}">
                                <controls:ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="4" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Status}" Opacity="0.72" />
                                        </Grid>
                                    </DataTemplate>
                                </controls:ItemsRepeater.ItemTemplate>
                            </controls:ItemsRepeater>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="校正狀態" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Expert.Calibration.Mode}" />
                            <TextBlock Text="{Binding Expert.Calibration.Status}" Opacity="0.72" />
                            <TextBlock Text="{Binding Expert.Calibration.Detail}" TextWrapping="Wrap" Opacity="0.72" />
                        </StackPanel>
                    </StackPanel>
                </controls:Expander>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="Easy 模式只顯示安全操作；切換 Expert 才會顯示 Matrix、DSP Graph、IR 與 VST3。" Opacity="0.64" TextWrapping="Wrap" />
    </Grid>
</Window>
