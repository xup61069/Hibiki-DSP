 <Slider Header="App 音量（dB）" Minimum="-60" Maximum="6" StepFrequency="0.5" Value="{Binding SessionVolumeDb, Mode=TwoWay}" Style="{StaticResource HibikiSliderStyle}" AutomationProperties.Name="App 工作階段音量" />
