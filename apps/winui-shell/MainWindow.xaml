<Window
    x:Class="Hibiki.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Hibiki DSP">
    <Grid x:Name="RootGrid" Padding="28" Background="#111217"
          AutomationProperties.Name="Hibiki DSP 音訊場景控制">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Hibiki DSP" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Audio Scene OS" Opacity="0.72" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding ConnectionStatusText}" VerticalAlignment="Center" />
                <Button Content="連接引擎" Click="OnConnectClick"
                        AutomationProperties.Name="連接 Hibiki 音訊引擎"
                        AutomationProperties.HelpText="連接後才能套用場景與音量控制" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,24,0,24">
            <StackPanel Spacing="18" MaxWidth="760">
                <Border Padding="20" CornerRadius="12" Background="#1D2028">
                    <StackPanel Spacing="12">
                        <TextBlock Text="先選輸出，再一鍵變好聽" FontSize="22" FontWeight="SemiBold" />
                        <ComboBox Header="輸出群組"
                                  AutomationProperties.Name="輸出群組"
                                  AutomationProperties.HelpText="選擇 Main、Low Latency 或 Surround 輸出"
                                  ItemsSource="{Binding OutputGroups}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedOutputGroup, Mode=TwoWay}" />
                        <ComboBox Header="實體輸出裝置"
                                  AutomationProperties.Name="實體輸出裝置"
                                  AutomationProperties.HelpText="只顯示引擎已驗證且目前 Active 的 render 裝置"
                                  ItemsSource="{Binding PhysicalDevices}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="EndpointId"
                                  SelectedValue="{Binding SelectedPhysicalDeviceId, Mode=TwoWay}" />
                        <Button Content="切換實體裝置" Click="OnSwitchDeviceClick"
                                IsEnabled="{Binding IsConnected}"
                                AutomationProperties.Name="切換實體輸出裝置"
                                AutomationProperties.HelpText="先預熱新裝置，再以 30 ms 交叉淡化；失敗會回復上一個裝置" />
                        <TextBlock Text="{Binding DeviceSwitchStatusText}" TextWrapping="Wrap" Opacity="0.72"
                                   AutomationProperties.LiveSetting="Polite" />
                        <Button Content="一鍵改善" Click="OnEnhanceClick" IsEnabled="{Binding IsConnected}"
                                AutomationProperties.Name="一鍵改善聲音"
                                AutomationProperties.HelpText="套用遊戲場景、校正與音量保護" />
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Opacity="0.82"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>

                <Border Padding="20" CornerRadius="12" Background="#1D2028">
                    <StackPanel Spacing="12">
                        <TextBlock Text="場景" FontSize="20" FontWeight="SemiBold" />
                        <controls:ItemsRepeater ItemsSource="{Binding Scenes}">
                            <controls:ItemsRepeater.Layout>
                                <controls:UniformGridLayout MaximumRowsOrColumns="2" MinItemWidth="260" MinItemHeight="84" />
                            </controls:ItemsRepeater.Layout>
                            <controls:ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding Id}" Click="OnSceneClick" HorizontalContentAlignment="Stretch"
                                            AutomationProperties.Name="{Binding Name}"
                                            AutomationProperties.HelpText="{Binding Description}">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.72" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </controls:ItemsRepeater.ItemTemplate>
                        </controls:ItemsRepeater>
                    </StackPanel>
                </Border>

                <Border Padding="20" CornerRadius="12" Background="#1D2028">
                    <StackPanel Spacing="10">
                        <TextBlock Text="自訂預設" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="建立最多 32 個自訂卡片；完整 DSP graph 由引擎端 Scene catalog 驗證。"
                                   TextWrapping="Wrap" Opacity="0.72" />
                        <TextBox Header="Scene ID（英文小寫）"
                                 Text="{Binding CustomSceneId, Mode=TwoWay}"
                                 AutomationProperties.Name="自訂場景 ID"
                                 AutomationProperties.HelpText="使用小寫英數、點、底線或連字號，最多 31 字元" />
                        <TextBox Header="名稱"
                                 Text="{Binding CustomSceneName, Mode=TwoWay}"
                                 AutomationProperties.Name="自訂場景名稱" />
                        <TextBox Header="說明"
                                 Text="{Binding CustomSceneDescription, Mode=TwoWay}"
                                 AutomationProperties.Name="自訂場景說明" />
                        <Button Content="加入自訂預設" Click="OnAddCustomSceneClick"
                                AutomationProperties.Name="加入自訂預設"
                                AutomationProperties.HelpText="加入後會保存到本機 user-space preset 檔案" />
                    </StackPanel>
                </Border>

                <Border Padding="20" CornerRadius="12" Background="#1D2028">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="音量保護" FontSize="20" FontWeight="SemiBold" />
                            <ToggleSwitch Grid.Column="1" Header="Expert" IsOn="{Binding IsExpert, Mode=TwoWay}"
                                          AutomationProperties.Name="Expert 詳細模式"
                                          AutomationProperties.HelpText="顯示 Matrix、DSP Graph、VST3 與校正狀態" />
                        </Grid>
                        <Slider Minimum="-60" Maximum="0" Value="{Binding RequestedVolumeDb, Mode=TwoWay}" ValueChanged="OnVolumeChanged"
                                AutomationProperties.Name="系統音量"
                                AutomationProperties.HelpText="以 dB 調整音量；安全限制會優先套用" />
                        <TextBlock Text="{Binding RequestedVolumeDb, StringFormat='{}{0:0.0} dB'}" />
                        <TextBlock Text="{Binding EffectiveVolumeDb, StringFormat='實際有效音量：{0:0.0} dB'}"
                                   AutomationProperties.Name="實際有效音量" />
                        <TextBlock Text="{Binding SafetyStatusText}" TextWrapping="Wrap" Opacity="0.82"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="{Binding VolumeOriginText}" Opacity="0.72" />
                        <TextBlock Text="{Binding VolumeActuatorText}" Opacity="0.72" />
                        <ToggleSwitch Header="靜音" IsOn="{Binding Muted, Mode=TwoWay}"
                                      AutomationProperties.Name="靜音"
                                      AutomationProperties.HelpText="淡出目前輸出並保留音量設定" />
                        <ComboBox Header="IR 相位模式"
                                  ItemsSource="{Binding IrPhaseModeOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Mode"
                                  SelectedValue="{Binding IrPhaseMode, Mode=TwoWay}"
                                  AutomationProperties.Name="IR 相位模式"
                                  AutomationProperties.HelpText="Game 低延遲、Balanced 混合相位、Movie 線性相位或 Bypass" />
                        <Slider Minimum="0" Maximum="1" StepFrequency="0.05"
                                Value="{Binding IrPhaseStrength, Mode=TwoWay}"
                                IsEnabled="{Binding IrPhaseUsesFir}"
                                AutomationProperties.Name="IR 相位強度"
                                AutomationProperties.HelpText="調整 mixed-phase 或 linear-phase 的延遲與相位折衷" />
                        <TextBlock Text="{Binding IrPhaseModeText}" Opacity="0.72" />
                        <TextBlock Text="{Binding IrAddedDelayMs, StringFormat='IR 額外延遲：{0:0.0} ms'}" Opacity="0.72" />
                        <TextBlock Text="尚未送出 IR／kernel prepare command；目前只保存相位 policy contract。"
                                   TextWrapping="Wrap" Opacity="0.72" />
                    </StackPanel>
                </Border>

                <controls:Expander Header="Expert 詳細控制（唯讀 contract）"
                                   AutomationProperties.Name="Expert 詳細控制"
                                   AutomationProperties.HelpText="唯讀顯示 Matrix、DSP Graph、VST3 隔離與校正狀態"
                                   IsExpanded="{Binding IsExpert, Mode=TwoWay}">
                    <StackPanel x:Name="ExpertPanel" Padding="8" Spacing="14">
                        <TextBlock Text="{Binding Expert.StatusText}" TextWrapping="Wrap" />

                        <StackPanel Spacing="6">
                            <TextBlock Text="來源與路由狀態" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Expert.RouteSummary}" Opacity="0.72" TextWrapping="Wrap" />
                            <controls:ItemsRepeater ItemsSource="{Binding Expert.RouteHealth}">
                                <controls:ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="4" Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding StateLabel}" />
                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Opacity="0.72" />
                                        </StackPanel>
                                    </DataTemplate>
                                </controls:ItemsRepeater.ItemTemplate>
                            </controls:ItemsRepeater>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="App 工作階段（暫時選取清單）" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SessionCatalogSequence, StringFormat='清單序號：{0}；刷新後 handle 會更新'}"
                                       Opacity="0.72" TextWrapping="Wrap" />
                            <controls:ItemsRepeater ItemsSource="{Binding SessionCatalog}">
                                <controls:ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="4" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding AccessibleSummary}" Opacity="0.72" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="{Binding RouteStateLabel}" />
                                                <Button Content="選取" Tag="{Binding Handle}"
                                                        Click="OnSessionSelectClick"
                                                        AutomationProperties.Name="選取 App 工作階段" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </controls:ItemsRepeater.ItemTemplate>
                            </controls:ItemsRepeater>
                            <TextBlock Text="{Binding SelectedSession.DisplayName, StringFormat='目前選取：{0}'}"
                                       Opacity="0.72" />
                            <TextBlock Text="{Binding SessionVolumeDb, StringFormat='App 音量：{0:0.0} dB'}"
                                       Opacity="0.72" />
                            <TextBlock Text="{Binding SelectedRouteRuleSummary}" TextWrapping="Wrap"
                                       AutomationProperties.Name="目前 App 路由預設預覽" />
                            <Slider Minimum="-60" Maximum="6" StepFrequency="0.5"
                                    Value="{Binding SessionVolumeDb, Mode=TwoWay}"
                                    AutomationProperties.Name="App 工作階段音量" />
                            <CheckBox Content="App 靜音"
                                      IsChecked="{Binding SessionMuted, Mode=TwoWay}"
                                      IsEnabled="{Binding HasSelectedSession}"
                                      AutomationProperties.Name="App 工作階段靜音" />
                            <Button Content="套用選取 App 音量" Click="OnApplySessionVolumeClick"
                                    IsEnabled="{Binding HasSelectedSession}"
                                    AutomationProperties.Name="套用選取 App 音量" />
                            <TextBox Header="Lane ID" Text="{Binding SessionRouteLaneId, Mode=TwoWay}"
                                     AutomationProperties.Name="App Lane ID" />
                            <TextBox Header="Output Group" Text="{Binding SessionRouteOutputGroup, Mode=TwoWay}"
                                     AutomationProperties.Name="App Output Group" />
                            <Button Content="套用選取 App 路由" Click="OnApplySessionRouteClick"
                                    IsEnabled="{Binding HasSelectedSession}"
                                    AutomationProperties.Name="套用選取 App 路由" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="App 路由預設（Expert）" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="建立後會保存到本機；只有 App 清單已同步且引擎回覆 Ack，才會顯示為已套用。App ID 或顯示名稱至少填一項。"
                                       TextWrapping="Wrap" Opacity="0.72" />
                            <controls:ItemsRepeater ItemsSource="{Binding RouteRules}">
                                <controls:ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="4" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"
                                                       AutomationProperties.Name="App 路由預設摘要" />
                                            <Button Grid.Column="1" Content="移除" Tag="{Binding RuleId}"
                                                    Click="OnRemoveRouteRuleClick"
                                                    AutomationProperties.Name="移除 App 路由預設" />
                                        </Grid>
                                    </DataTemplate>
                                </controls:ItemsRepeater.ItemTemplate>
                            </controls:ItemsRepeater>
                            <TextBox Header="預設 ID（小寫英文／數字／- _ .）"
                                     Text="{Binding RouteRuleId, Mode=TwoWay}"
                                     AutomationProperties.Name="App 路由預設 ID" />
                            <TextBox Header="App ID（例如 game.exe，可留空）"
                                     Text="{Binding RouteRuleAppId, Mode=TwoWay}"
                                     AutomationProperties.Name="App 路由預設 App ID" />
                            <TextBox Header="顯示名稱（可留空）"
                                     Text="{Binding RouteRuleDisplayName, Mode=TwoWay}"
                                     AutomationProperties.Name="App 路由預設顯示名稱" />
                            <TextBox Header="Lane ID" Text="{Binding RouteRuleLaneId, Mode=TwoWay}"
                                     AutomationProperties.Name="App 路由預設 Lane ID" />
                            <TextBox Header="Output Group（main／low-latency／surround）"
                                     Text="{Binding RouteRuleOutputGroup, Mode=TwoWay}"
                                     AutomationProperties.Name="App 路由預設 Output Group" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:NumberBox Header="優先級" Value="{Binding RouteRulePriority, Mode=TwoWay}"
                                                    SpinButtonPlacementMode="Compact"
                                                    AutomationProperties.Name="App 路由預設優先級" />
                                <controls:NumberBox Grid.Column="1" Header="補償增益 dB" Value="{Binding RouteRuleMakeupGainDb, Mode=TwoWay}"
                                                    SpinButtonPlacementMode="Compact"
                                                    AutomationProperties.Name="App 路由預設補償增益" />
                            </Grid>
                            <Grid ColumnSpacing="10">
                                <CheckBox Content="啟用預設" IsChecked="{Binding RouteRuleEnabled, Mode=TwoWay}"
                                          AutomationProperties.Name="啟用 App 路由預設" />
                                <ComboBox Grid.Column="1" Header="增益控制者"
                                          ItemsSource="{Binding RouteRuleGainOwners}"
                                          SelectedItem="{Binding RouteRuleGainOwner, Mode=TwoWay}"
                                          AutomationProperties.Name="App 路由預設增益控制者" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="新增／更新預設" Click="OnApplyRouteRuleClick"
                                        AutomationProperties.Name="新增或更新 App 路由預設" />
                                <Button Content="清除全部預設" Click="OnClearRouteRulesClick"
                                        AutomationProperties.Name="清除全部 App 路由預設" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Matrix" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Expert.MatrixSummary}" Opacity="0.72" />
                            <controls:ItemsRepeater ItemsSource="{Binding Expert.MatrixRoutes}">
                                <controls:ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="4" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Source}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Destination}" />
                                            <TextBlock Grid.Column="2" Text="{Binding GainDb, StringFormat='{}{0:0.0} dB'}" />
                                        </Grid>
                                    </DataTemplate>
                                </controls:ItemsRepeater.ItemTemplate>
                            </controls:ItemsRepeater>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="DSP Graph" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Expert.DspSummary}" Opacity="0.72" />
                            <controls:ItemsRepeater ItemsSource="{Binding Expert.DspGraph}">
                                <controls:ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="4" Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" Opacity="0.72" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </controls:ItemsRepeater.ItemTemplate>
                            </controls:ItemsRepeater>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="VST3 隔離 Lane" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Expert.Vst3Summary}" Opacity="0.72" TextWrapping="Wrap" />
                            <controls:ItemsRepeater ItemsSource="{Binding Expert.Vst3Lanes}">
                                <controls:ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="4" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Status}" Opacity="0.72" />
                                        </Grid>
                                    </DataTemplate>
                                </controls:ItemsRepeater.ItemTemplate>
                            </controls:ItemsRepeater>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="校正狀態" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Expert.Calibration.Mode}" />
                            <TextBlock Text="{Binding Expert.Calibration.Status}" Opacity="0.72" />
                            <TextBlock Text="{Binding Expert.Calibration.Detail}" TextWrapping="Wrap" Opacity="0.72" />
                        </StackPanel>
                    </StackPanel>
                </controls:Expander>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="Easy 模式只顯示安全操作；切換 Expert 才會顯示 Matrix、DSP Graph、IR 與 VST3。" Opacity="0.64" TextWrapping="Wrap" />
    </Grid>
</Window>
