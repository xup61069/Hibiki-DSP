<Window x:Class="Hibiki.WinUI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Microsoft.UI.Xaml.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" Title="Hibiki DSP">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Padding="0" AutomationProperties.Name="Hibiki DSP 音訊場景控制">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#F0F4F9" />
                        <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{StaticResource SystemAccentColor}" />
                        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource SystemAccentColor}" />
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource SystemAccentColor}" />
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{StaticResource SystemAccentColor}" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#161B24" />
                        <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{StaticResource SystemAccentColorLight1}" />
                        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource SystemAccentColorLight1}" />
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource SystemAccentColorLight1}" />
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{StaticResource SystemAccentColorLight1}" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title-bar row: drag region on the left, interactive controls pinned right -->
        <Grid ColumnSpacing="12" Padding="36,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="TitleBarDragRegion" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="18" Height="18" CornerRadius="5" Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon FontSize="10" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="&#xE767;" />
                </Border>
                <TextBlock Text="Hibiki DSP" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <!-- Connected state: success-green border + green dot -->
                <Grid>
                  <Border Style="{StaticResource StatusPillStyle}" BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                          Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding ConnectionStatusText}" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource StatusPillStyle}" BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                          Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding ConnectionStatusText}" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                  </Border>
                </Grid>
            </StackPanel>
        </Grid>



        <controls:NavigationView x:Name="ShellNav" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" OpenPaneLength="244" SelectionChanged="OnShellNavSelectionChanged" AutomationProperties.Name="主要導覽">
  <controls:NavigationView.MenuItems>
    <controls:NavigationViewItem Content="快速開始" Tag="home" IsSelected="True" AutomationProperties.Name="快速開始頁面">
      <controls:NavigationViewItem.Icon>
        <FontIcon Glyph="" />
      </controls:NavigationViewItem.Icon>
      <controls:NavigationViewItem.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="Number1" />
      </controls:NavigationViewItem.KeyboardAccelerators>
    </controls:NavigationViewItem>
    <controls:NavigationViewItem Content="場景" Tag="scenes" AutomationProperties.Name="場景頁面">
      <controls:NavigationViewItem.Icon>
        <FontIcon Glyph="" />
      </controls:NavigationViewItem.Icon>
      <controls:NavigationViewItem.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="Number2" />
      </controls:NavigationViewItem.KeyboardAccelerators>
    </controls:NavigationViewItem>
    <controls:NavigationViewItem Content="自訂預設" Tag="presets" AutomationProperties.Name="自訂預設頁面">
      <controls:NavigationViewItem.Icon>
        <FontIcon Glyph="" />
      </controls:NavigationViewItem.Icon>
      <controls:NavigationViewItem.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="Number3" />
      </controls:NavigationViewItem.KeyboardAccelerators>
    </controls:NavigationViewItem>
    <controls:NavigationViewItem Content="音量保護" Tag="volume" AutomationProperties.Name="音量保護頁面">
      <controls:NavigationViewItem.Icon>
        <FontIcon Glyph="" />
      </controls:NavigationViewItem.Icon>
      <controls:NavigationViewItem.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="Number4" />
      </controls:NavigationViewItem.KeyboardAccelerators>
    </controls:NavigationViewItem>
    <controls:NavigationViewItem Content="路由健康" Tag="route" AutomationProperties.Name="路由健康頁面">
      <controls:NavigationViewItem.Icon>
        <FontIcon Glyph="" />
      </controls:NavigationViewItem.Icon>
      <controls:NavigationViewItem.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="Number5" />
      </controls:NavigationViewItem.KeyboardAccelerators>
    </controls:NavigationViewItem>
    <controls:NavigationViewItem Content="Expert Panel" Tag="expert" AutomationProperties.Name="Expert Panel 頁面">
      <controls:NavigationViewItem.Icon>
        <FontIcon Glyph="" />
      </controls:NavigationViewItem.Icon>
      <controls:NavigationViewItem.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="Number6" />
      </controls:NavigationViewItem.KeyboardAccelerators>
    </controls:NavigationViewItem>
  </controls:NavigationView.MenuItems>
  <controls:NavigationView.PaneHeader>
    <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,0,12,4">
        <Border Width="28" Height="28" CornerRadius="7" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center">
            <FontIcon FontSize="14" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="&#xE767;" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="Hibiki DSP" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
    </StackPanel>
</controls:NavigationView.PaneHeader>
  <controls:NavigationView.Content>
    <Grid RowSpacing="12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <controls:InfoBar x:Name="DisconnectedBanner" IsOpen="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}" Severity="Warning" CornerRadius="12" Title="尚未連接引擎" Message="連接後才能套用場景、音量與路由控制。點擊「連接引擎」開始。" IsClosable="False" Margin="36,16,36,0" AutomationProperties.Name="引擎連線狀態提醒" Grid.Row="0" /><ScrollViewer Grid.Row="1" Padding="36,8,36,36">
        <StackPanel MaxWidth="1080" Spacing="20">
        <Grid x:Name="ShellHomeSection"><Grid.Transitions><TransitionCollection><EntranceThemeTransition FromVerticalOffset="24" IsStaggeringEnabled="True" /></TransitionCollection></Grid.Transitions><Border Padding="28" CornerRadius="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1A0866CC" Offset="0.0" /><GradientStop Color="#0C0866CC" Offset="0.5" /><GradientStop Color="Transparent" Offset="1.0" /></LinearGradientBrush></Border.Background><Border.Transitions><TransitionCollection><EntranceThemeTransition FromVerticalOffset="16" /></TransitionCollection></Border.Transitions>
                    <Grid x:Name="HeroLayout" ColumnSpacing="32" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="300" />
                            <ColumnDefinition x:Name="HeroQuickStartColumn" Width="380" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState x:Name="HeroNarrowState">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="0" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="HeroQuickStartPanel.(Grid.Column)" Value="0" />
                                        <Setter Target="HeroQuickStartPanel.(Grid.Row)" Value="1" />
                                        <Setter Target="HeroQuickStartColumn.Width" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="HeroWideState">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="840" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="先選輸出，再一鍵變好聽" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                            <ComboBox Header="輸出群組" AutomationProperties.Name="輸出群組" AutomationProperties.HelpText="選擇 Main、Low Latency 或 Surround 輸出" ItemsSource="{Binding OutputGroups}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedOutputGroup, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                            <ComboBox Header="實體輸出裝置" AutomationProperties.Name="實體輸出裝置" AutomationProperties.HelpText="只顯示引擎已驗證且目前 Active 的 render 裝置" ItemsSource="{Binding PhysicalDevices}" DisplayMemberPath="DisplayName" SelectedValuePath="EndpointId" SelectedValue="{Binding SelectedPhysicalDeviceId, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                            <StackPanel x:Name="DeviceActionRow" Orientation="Vertical" Spacing="6" AutomationProperties.Name="實體裝置控制">
                                <TextBlock Text="裝置動作" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Border Style="{StaticResource SectionCardStyle}" PointerEntered="OnSectionCardPointerEntered" PointerExited="OnSectionCardPointerExited">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Content="切換實體裝置" Click="OnSwitchDeviceClick" IsEnabled="{Binding IsConnected}" Style="{StaticResource AccentButtonStyle}" MinHeight="40" FontWeight="SemiBold" AutomationProperties.Name="切換實體輸出裝置" AutomationProperties.HelpText="先預熱新裝置，再以 30 ms 交叉淡化；失敗會回復上一個裝置" ToolTipService.ToolTip="先預熱新裝置，再以 30 ms 交叉淡化；失敗會回復上一個裝置" />
                                        <Button Content="重新掃描裝置" Click="OnRefreshPhysicalDevicesClick" IsEnabled="{Binding IsConnected}" MinHeight="40" AutomationProperties.Name="重新掃描實體輸出裝置" AutomationProperties.HelpText="向引擎要求最新裝置快照；失敗時保留目前清單" ToolTipService.ToolTip="向引擎要求最新裝置快照" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <Border Style="{StaticResource StatusPillStyle}">
                                <TextBlock Text="{Binding DeviceSwitchStatusText}" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" MaxWidth="420" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="HeroQuickStartPanel" Grid.Column="1" Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="快速開始" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <ProgressRing Width="26" Height="26" IsActive="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" VerticalAlignment="Center" />
                                <Button x:Name="ConnectButton" Content="連接引擎" Click="OnConnectClick" MinHeight="40" FontWeight="SemiBold" Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="連接 Hibiki 音訊引擎" AutomationProperties.HelpText="連接後才能套用場景與音量控制" ToolTipService.ToolTip="連接 Hibiki 音訊引擎" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Content="一鍵改善" Click="OnEnhanceClick" IsEnabled="{Binding IsConnected}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" MinHeight="40" FontWeight="SemiBold" AutomationProperties.Name="一鍵改善聲音" AutomationProperties.HelpText="套用遊戲場景、校正與音量保護" ToolTipService.ToolTip="套用遊戲場景、校正與音量保護" />
                            <Border Style="{StaticResource StatusPillStyle}">
                                <TextBlock Text="{Binding StatusText}" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" MaxWidth="340" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border></Grid>
          <Grid x:Name="ShellScenesSection" Visibility="Collapsed"><Grid.Transitions><TransitionCollection><EntranceThemeTransition FromVerticalOffset="24" IsStaggeringEnabled="True" /></TransitionCollection></Grid.Transitions><Border Style="{StaticResource SectionCardStyle}" Padding="28"><Border.Transitions><TransitionCollection><EntranceThemeTransition FromVerticalOffset="16" /></TransitionCollection></Border.Transitions>
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="場景" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <controls:ItemsRepeater x:Name="SceneCardRepeater" ItemsSource="{Binding Scenes}" ElementPrepared="OnSceneCardPrepared">
                            <controls:ItemsRepeater.Layout>
                                <controls:UniformGridLayout MaximumRowsOrColumns="2" MinItemWidth="260" MinItemHeight="84" />
                            </controls:ItemsRepeater.Layout>
                            <controls:ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding Id}" Click="OnSceneClick" HorizontalContentAlignment="Stretch" Style="{StaticResource SceneCardStyle}" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Description}">
                                        <StackPanel Spacing="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Border Grid.Column="1" Visibility="{Binding SafetyEnabled, Converter={StaticResource BoolToVisibilityConverter}}" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                        <TextBlock Text="安全" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Border Style="{StaticResource StatusPillCompactStyle}" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                <TextBlock Text="{Binding LatencyLabel}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </controls:ItemsRepeater.ItemTemplate>
                        </controls:ItemsRepeater>
                    </StackPanel>
                </Border></Grid>
          <Grid x:Name="ShellPresetsSection" Visibility="Collapsed"><Grid.Transitions><TransitionCollection><EntranceThemeTransition FromVerticalOffset="24" IsStaggeringEnabled="True" /></TransitionCollection></Grid.Transitions><Border Style="{StaticResource SectionCardStyle}" Padding="28"><Border.Transitions><TransitionCollection><EntranceThemeTransition FromVerticalOffset="16" /></TransitionCollection></Border.Transitions>
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="自訂預設" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="建立最多 32 個自訂卡片；完整 DSP graph 由引擎端 Scene catalog 驗證。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <controls:ItemsRepeater ItemsSource="{Binding CustomSceneCards}">
                            <controls:ItemsRepeater.Layout>
                                <controls:UniformGridLayout MaximumRowsOrColumns="2" MinItemWidth="260" MinItemHeight="72" />
                            </controls:ItemsRepeater.Layout>
                            <controls:ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Grid Style="{StaticResource RouteItemCardGridStyle}" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Id}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="移除" Tag="{Binding Id}" Click="OnRemoveCustomSceneClick" MinHeight="32" AutomationProperties.Name="移除自訂場景" AutomationProperties.HelpText="移除本機保存的自訂卡片；不會改變引擎端 Scene catalog" ToolTipService.ToolTip="移除自訂卡片" />
                                    </Grid>
                                </DataTemplate>
                            </controls:ItemsRepeater.ItemTemplate>
                        </controls:ItemsRepeater>
                        <Grid x:Name="CustomFormLayout" ColumnSpacing="16" RowSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="280" />
                                <ColumnDefinition x:Name="CustomFormSecondColumn" Width="0" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup>
                                    <VisualState x:Name="CustomFormNarrowState">
                                        <VisualState.StateTriggers>
                                            <AdaptiveTrigger MinWindowWidth="0" />
                                        </VisualState.StateTriggers>
                                        <VisualState.Setters>
                                            <Setter Target="CustomFormDescriptionBox.(Grid.Column)" Value="0" />
                                            <Setter Target="CustomFormDescriptionBox.(Grid.Row)" Value="2" />
                                            <Setter Target="CustomFormSecondColumn.Width" Value="0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CustomFormWideState">
                                        <VisualState.StateTriggers>
                                            <AdaptiveTrigger MinWindowWidth="720" />
                                        </VisualState.StateTriggers>
                                        <VisualState.Setters>
                                            <Setter Target="CustomFormSecondColumn.Width" Value="1*" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <TextBox Header="Scene ID（英文小寫）" Text="{Binding CustomSceneId, Mode=TwoWay}" AutomationProperties.Name="自訂場景 ID" AutomationProperties.HelpText="使用小寫英數、點、底線或連字號，最多 31 字元" />
                            <TextBox x:Name="CustomFormNameBox" Grid.Column="1" Header="名稱" Text="{Binding CustomSceneName, Mode=TwoWay}" AutomationProperties.Name="自訂場景名稱" />
                            <TextBox x:Name="CustomFormDescriptionBox" Grid.Row="2" Header="說明" Text="{Binding CustomSceneDescription, Mode=TwoWay}" AutomationProperties.Name="自訂場景說明" />
                            <ToggleSwitch Grid.Row="3" Header="音量連動等響度" IsOn="{Binding CustomSceneLoudnessLiveUpdate, Mode=TwoWay}" AutomationProperties.Name="音量連動等響度" AutomationProperties.HelpText="開啟後此場景的等響度補償會隨輸出音量自動重新計算；關閉時維持固定曲線" ToolTipService.ToolTip="隨音量自動更新等響度補償（選用）" />
                        </Grid>
                        <Button Content="加入自訂預設" Click="OnAddCustomSceneClick" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" MinHeight="40" FontWeight="SemiBold" AutomationProperties.Name="加入自訂預設" AutomationProperties.HelpText="加入後會保存到本機 user-space preset 檔案" ToolTipService.ToolTip="保存到本機 user-space preset 檔案" />
                    </StackPanel>
                </Border></Grid>
          <Grid x:Name="ShellVolumeSection" Visibility="Collapsed"><Grid.Transitions><TransitionCollection><EntranceThemeTransition FromVerticalOffset="24" IsStaggeringEnabled="True" /></TransitionCollection></Grid.Transitions><Border Style="{StaticResource SectionCardStyle}" Padding="28"><Border.Transitions><TransitionCollection><EntranceThemeTransition FromVerticalOffset="16" /></TransitionCollection></Border.Transitions>
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="音量保護" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Header="Expert" IsOn="{Binding IsExpert, Mode=TwoWay}" AutomationProperties.Name="Expert 詳細模式" AutomationProperties.HelpText="顯示 Matrix、DSP Graph、VST3 與校正狀態" />
                        </Grid>
                        <Slider Header="系統音量（dB）" Minimum="-60" Maximum="0" Value="{Binding RequestedVolumeDb, Mode=TwoWay}" ValueChanged="OnVolumeChanged" Style="{StaticResource HibikiSliderStyle}" AutomationProperties.Name="系統音量" AutomationProperties.HelpText="以 dB 調整音量；安全限制會優先套用" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource StatusPillStyle}">
                                <TextBlock Text="{Binding RequestedVolumeDisplayText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <Border Style="{StaticResource StatusPillStyle}">
                                <TextBlock Text="{Binding EffectiveVolumeDisplayText}" Style="{ThemeResource CaptionTextBlockStyle}" AutomationProperties.Name="實際有效音量" AutomationProperties.HelpText="{Binding EffectiveVolumeDb}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <Border Style="{StaticResource StatusPillStyle}">
                            <TextBlock Text="{Binding SafetyStatusText}" TextWrapping="Wrap" MaxWidth="520" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource StatusPillStyle}">
                                <TextBlock Text="{Binding VolumeOriginText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <Border Style="{StaticResource StatusPillStyle}">
                                <TextBlock Text="{Binding VolumeActuatorText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <ToggleSwitch Header="靜音" IsOn="{Binding Muted, Mode=TwoWay}" AutomationProperties.Name="靜音" AutomationProperties.HelpText="淡出目前輸出並保留音量設定" />
                        <Border Style="{StaticResource SectionCardStyle}" Margin="0,4,0,0" PointerEntered="OnSectionCardPointerEntered" PointerExited="OnSectionCardPointerExited">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="現代等化器" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <Border Grid.Column="1" CornerRadius="999" Padding="10,4" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                        <TextBlock Text="{Binding EqSurface.StateText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" AutomationProperties.LiveSetting="Polite" />
                                    </Border>
                                </Grid>
