<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="HibikiSliderTrackFill" Opacity="0.28" Color="{StaticResource SystemAccentColor}" />
            <StaticResource x:Key="SliderTrackFill" ResourceKey="HibikiSliderTrackFill" />
            <StaticResource x:Key="SliderTrackFillPointerOver" ResourceKey="HibikiSliderTrackFill" />
            <StaticResource x:Key="SliderTrackFillPressed" ResourceKey="HibikiSliderTrackFill" />
            <SolidColorBrush x:Key="HibikiSectionCardBrush">#F0F4F9F0</SolidColorBrush>
            <SolidColorBrush x:Key="HibikiRouteItemBrush">#FFFFFFB8</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="HibikiSliderTrackFill" Opacity="0.36" Color="{StaticResource SystemAccentColor}" />
            <StaticResource x:Key="SliderTrackFill" ResourceKey="HibikiSliderTrackFill" />
            <StaticResource x:Key="SliderTrackFillPointerOver" ResourceKey="HibikiSliderTrackFill" />
            <StaticResource x:Key="SliderTrackFillPressed" ResourceKey="HibikiSliderTrackFill" />
            <SolidColorBrush x:Key="HibikiSectionCardBrush">#1A202C90</SolidColorBrush>
            <SolidColorBrush x:Key="HibikiRouteItemBrush">#262D3A80</SolidColorBrush>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Audio-app slider: thicker rounded track with a soft accent rail
         under the filled portion. Built on the default WinUI Slider
         template resources so hover, pressed, disabled and RTL behavior
         keep working unchanged. -->
    <Style x:Key="HibikiSliderStyle" TargetType="Slider">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>

    <!-- Bold section card with layered surface and generous corner radius. -->
    <Style x:Key="SectionCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="20" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Background" Value="{ThemeResource HibikiSectionCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Transitions">
            <Setter.Value>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="20" />
                </TransitionCollection>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shared route/session item cards with compact inner surfaces. -->
    <Style x:Key="RouteItemCardGridStyle" TargetType="Grid">
        <Setter Property="Padding" Value="14" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{ThemeResource HibikiRouteItemBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="RouteItemCardStackStyle" TargetType="StackPanel">
        <Setter Property="Padding" Value="14" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{ThemeResource HibikiRouteItemBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

</ResourceDictionary>
