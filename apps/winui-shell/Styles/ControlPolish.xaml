<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="HibikiSliderTrackFill" Opacity="0.28" Color="{StaticResource SystemAccentColor}" />
            <StaticResource x:Key="SliderTrackFill" ResourceKey="HibikiSliderTrackFill" />
            <StaticResource x:Key="SliderTrackFillPointerOver" ResourceKey="HibikiSliderTrackFill" />
            <StaticResource x:Key="SliderTrackFillPressed" ResourceKey="HibikiSliderTrackFill" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="HibikiSliderTrackFill" Opacity="0.36" Color="{StaticResource SystemAccentColor}" />
            <StaticResource x:Key="SliderTrackFill" ResourceKey="HibikiSliderTrackFill" />
            <StaticResource x:Key="SliderTrackFillPointerOver" ResourceKey="HibikiSliderTrackFill" />
            <StaticResource x:Key="SliderTrackFillPressed" ResourceKey="HibikiSliderTrackFill" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Audio-app slider: thicker rounded track with a soft accent rail
         under the filled portion. Built on the default WinUI Slider
         template resources so hover, pressed, disabled and RTL behavior
         keep working unchanged. -->
    <Style x:Key="HibikiSliderStyle" TargetType="Slider">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>

    <!-- Section card surface with a subtle accent border highlight on pointer-over.
         Hover is applied from code-behind because Border has no visual states.
         Uses the same corner/padding rhythm as the scene cards (CR12/P16). -->
    <Style x:Key="SectionCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="16" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Shared card surface for route-health rows, App session rows, matrix
         routes and VST3 lanes. Extracted from duplicated inline attributes so
         all inner list items share the same corner radius and padding. -->
    <Style x:Key="RouteItemCardGridStyle" TargetType="Grid">
        <Setter Property="Padding" Value="12" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="RouteItemCardStackStyle" TargetType="StackPanel">
        <Setter Property="Padding" Value="12" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

</ResourceDictionary>
