<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="HibikiSliderTrackFill" Opacity="0.28" Color="{StaticResource SystemAccentColor}" />
            <StaticResource x:Key="SliderTrackFill" ResourceKey="HibikiSliderTrackFill" />
            <StaticResource x:Key="SliderTrackFillPointerOver" ResourceKey="HibikiSliderTrackFill" />
            <StaticResource x:Key="SliderTrackFillPressed" ResourceKey="HibikiSliderTrackFill" />
            <SolidColorBrush x:Key="HibikiShellSurfaceBrush">#F4F7FB</SolidColorBrush>
            <SolidColorBrush x:Key="HibikiSectionCardBrush">#F6F9FC</SolidColorBrush>
            <SolidColorBrush x:Key="HibikiRouteItemBrush">#FFFFFFD8</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="HibikiSliderTrackFill" Opacity="0.36" Color="{StaticResource SystemAccentColor}" />
            <StaticResource x:Key="SliderTrackFill" ResourceKey="HibikiSliderTrackFill" />
            <StaticResource x:Key="SliderTrackFillPointerOver" ResourceKey="HibikiSliderTrackFill" />
            <StaticResource x:Key="SliderTrackFillPressed" ResourceKey="HibikiSliderTrackFill" />
            <SolidColorBrush x:Key="HibikiShellSurfaceBrush">#1D2430</SolidColorBrush>
            <!-- Keep the dark shell layered instead of collapsing into one black plane. -->
            <SolidColorBrush x:Key="HibikiSectionCardBrush">#2B3547</SolidColorBrush>
            <SolidColorBrush x:Key="HibikiRouteItemBrush">#354761</SolidColorBrush>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Audio-app slider: thicker rounded track with a soft accent rail
         under the filled portion. Built on the default WinUI Slider
         template resources so hover, pressed, disabled and RTL behavior
         keep working unchanged. -->
    <Style x:Key="HibikiSliderStyle" TargetType="Slider">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>

    <!-- Keep the page canvas distinct from the Mica backdrop in both themes.
         This is intentionally an implicit shell-level style so every page
         gets the same surface without changing its bindings or layout. -->
    <Style TargetType="NavigationView">
        <Setter Property="Background" Value="{ThemeResource HibikiShellSurfaceBrush}" />
    </Style>

    <!-- Bold section card with layered surface and generous corner radius. -->
    <Style x:Key="SectionCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="20" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Background" Value="{ThemeResource HibikiSectionCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Shared route/session item cards with compact inner surfaces. -->
    <Style x:Key="RouteItemCardGridStyle" TargetType="Grid">
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{ThemeResource HibikiRouteItemBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="RouteItemCardStackStyle" TargetType="StackPanel">
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{ThemeResource HibikiRouteItemBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Status footer: accent-colored left edge with a subtle top divider.
         Keep all border values here so local attributes cannot override
         the intended accent treatment. -->
    <Style x:Key="FooterAccentBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource HibikiShellSurfaceBrush}" />
        <Setter Property="Padding" Value="36,12,36,16" />
        <Setter Property="BorderBrush">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0.0">
                        <GradientStop.Color>
                            <StaticResource ResourceKey="SystemAccentColor" />
                        </GradientStop.Color>
                    </GradientStop>
                    <GradientStop Offset="0.28">
                        <GradientStop.Color>
                            <StaticResource ResourceKey="SystemAccentColor" />
                        </GradientStop.Color>
                    </GradientStop>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="4,1,0,0" />
    </Style>

</ResourceDictionary>
