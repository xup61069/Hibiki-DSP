<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Modern text input surface with softer rounded corners.
         Implicit style applies to every TextBox without per-instance markup. -->
    <Style TargetType="TextBox">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- Match the TextBox input surface so dropdown selectors share the same
         visual rhythm. Implicit style applies to every ComboBox. -->
    <Style TargetType="ComboBox">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="36" />
    </Style>
</ResourceDictionary>
