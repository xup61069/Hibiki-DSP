    <ResourceDictionary
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Give metadata badges their own surface so short status text does not
         disappear into the surrounding shell or section card. Keep the
         palette deliberately quieter than input controls. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="HibikiStatusPillBrush">#DDE8F4</SolidColorBrush>
            <SolidColorBrush x:Key="HibikiStatusPillCompactBrush">#E7EEF6</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="HibikiStatusPillBrush">#3D4C62</SolidColorBrush>
            <SolidColorBrush x:Key="HibikiStatusPillCompactBrush">#344256</SolidColorBrush>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Modern text input surface with softer rounded corners.
         Implicit style applies to every TextBox without per-instance markup. -->
    <Style TargetType="TextBox">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- Match the TextBox input surface so dropdown selectors share the same
         visual rhythm. Implicit style applies to every ComboBox. -->
    <Style TargetType="ComboBox">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="36" />
    </Style>

    <!-- Keep opened option rows in the same rounded, compact language as the
         selector surface without replacing the platform popup template. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,4" />
    </Style>

    <!-- Keep numeric form fields in the same visual rhythm as text inputs
         while leaving the platform spin-button template intact. -->
    <Style TargetType="NumberBox">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="36" />
    </Style>


    <!-- Keep the hit target consistent while tightening the optional header
         row. The title-bar uses a 48px host row; without this small template
         adjustment the default Header + switch layout crowds its On/Off
         content against the bottom clip boundary. -->
    <Style TargetType="ToggleSwitch">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Margin="0,0,0,-10" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Consistent minimum height and comfortable padding for check boxes.
         Implicit style applies to every CheckBox. -->
    <Style TargetType="CheckBox">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <!-- Shared pill-shaped status badge surface. Apply with Style="{StaticResource StatusPillStyle}"
         and override BorderBrush for semantic colors (success/caution). -->
    <Style x:Key="StatusPillStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,20,0" />
        <Setter Property="Background" Value="{ThemeResource HibikiStatusPillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Compact variant for inline list-row badges (smaller padding). -->
    <Style x:Key="StatusPillCompactStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{ThemeResource HibikiStatusPillCompactBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Keep button corners and the shared 36px hit target consistent.
         Primary (accent) buttons retain their explicit 40px hierarchy. -->
    <Style TargetType="Button">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="36" />
    </Style></ResourceDictionary>
