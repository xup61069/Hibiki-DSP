<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Modern text input surface with softer rounded corners.
         Implicit style applies to every TextBox without per-instance markup. -->
    <Style TargetType="TextBox">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- Match the TextBox input surface so dropdown selectors share the same
         visual rhythm. Implicit style applies to every ComboBox. -->
    <Style TargetType="ComboBox">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="36" />
    </Style>

    <!-- Keep numeric form fields in the same visual rhythm as text inputs
         while leaving the platform spin-button template intact. -->
    <Style TargetType="NumberBox">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="36" />
    </Style>


    <!-- Keep the hit target consistent while tightening the optional header
         row. The title-bar uses a 48px host row; without this small template
         adjustment the default Header + switch layout crowds its On/Off
         content against the bottom clip boundary. -->
    <Style TargetType="ToggleSwitch">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Margin="0,0,0,-10" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Consistent minimum height and comfortable padding for check boxes.
         Implicit style applies to every CheckBox. -->
    <Style TargetType="CheckBox">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="8,4" />
    </Style>
    <!-- Shared pill-shaped status badge surface. Apply with Style="{StaticResource StatusPillStyle}"
         and override BorderBrush for semantic colors (success/caution). -->
    <Style x:Key="StatusPillStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Compact variant for inline list-row badges (smaller padding). -->
    <Style x:Key="StatusPillCompactStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Subtle button elevation: all buttons get a gentle entrance transition.
         Primary (accent) buttons already have color feedback; this adds motion. -->
    <Style TargetType="Button">
        <Setter Property="CornerRadius" Value="6" />
    </Style></ResourceDictionary>
